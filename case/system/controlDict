FoamFile {
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application buoyantBoussinesqSimpleFoam;

startFrom latestTime;

startTime 0;

stopAt endTime;

endTime 10;

deltaT 0.001;

writeControl timeStep;

writeInterval 100;

purgeWrite 0;

writeFormat ascii;

writePrecision 6;

writeCompression off;

timeFormat general;

timePrecision 6;

runTimeModifiable true;

functions
{
    midPlaneY
    {
        type            sets;
        libs            ("libsampling.so");
        executeControl  writeTime;
        writeControl    writeTime;
        interpolationScheme cellPoint;
        setFormat       csv;
        sets
        (
            midY
            {
                type    uniform;
                axis    distance;
                start   (0 0.5 0.05);
                end     (1 0.5 0.05);
                nPoints 100;
            }
        );
        fields          ( U T );
    }

    midPlaneX
    {
        type            sets;
        libs            ("libsampling.so");
        executeControl  writeTime;
        writeControl    writeTime;
        interpolationScheme cellPoint;
        setFormat       csv;
        sets
        (
            midX
            {
                type    uniform;
                axis    distance;
                start   (0.5 0 0.05);
                end     (0.5 1 0.05);
                nPoints 100;
            }
        );
        fields          ( U T );
    }
}

