FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    hotWall
    {
        type            omegaWallFunction;
        value           uniform 0.01;
    }
    coldWall
    {
        type            omegaWallFunction;
        value           uniform 0.01;
    }
    adiabaticWalls
    {
        type            omegaWallFunction;
        value           uniform 0.01;
    }
    frontAndBack
    {
        type            empty;
    }
}
